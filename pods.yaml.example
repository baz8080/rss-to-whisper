verbose: false

# Stop walking a feed after this many already-transcribed episodes in a row.
# Feeds are newest-first, so the default is enough to pick up new episodes
# cheaply. Raise it (e.g. 5000) to force a full-feed walk when backfilling.
skip_after_consecutive: 20

# Episodes downloaded but never transcribed before their feed entry aged out are
# stranded -- no later run looks at them again. Recovery transcribes them in place
# using what the directory name and the feed still carry. Set to false to follow
# the feed and nothing else.
recover_orphans: true

# Cap how many orphans one run will transcribe, across all podcasts, so a large
# backlog cannot crowd out new episodes. 0 means no limit.
orphan_recovery_limit: 0

# Titles matching any of these are skipped for every feed. Matching is
# case-insensitive and on whole words, so "repeat" does not hit "repeating".
# Omit the key to accept the defaults below; set it to [] to disable.
exclude_title_keywords:
- trailer
- introducing
- encore
- classic episode
- rewind
- re-release
- re-run
- rerun
- rebroadcast
- best of
- repeat
- replay
- from the archives

# What whisper decodes in. An ISO 639-1 code, or "auto" to detect it from the
# audio. A podcast can override this; everything else inherits it.
#
# Note: the initial prompt that fixes unpunctuated decodes is English prose, so
# it is only sent when decoding English. A feed set to anything else gives up
# that lever rather than being biased toward English. See the README.
language: en

# Skip episodes shorter than this. Below ~150s a feed is almost entirely
# trailers, promos and hiatus notices. Feeds without an itunes:duration are
# never filtered on length. Set to 0 to disable.
min_episode_duration_seconds: 150

podcasts:
- name: Ask a Spaceman
  url: https://feeds.libsyn.com/60664
  collections:
  - science
  - space
  - astrophysics
  excludes:
  - introducing

# Feeds that publish genuine short-form episodes need the length floor lifted,
# or the global default eats their back catalogue.
- name: A Short-Form Show
  url: https://example.com/feed.rss
  min_episode_duration_seconds: 0

# A feed in another language overrides the global setting rather than forcing
# every other show to be detected.
- name: Une Emission Francaise
  url: https://example.com/fr.rss
  language: fr
